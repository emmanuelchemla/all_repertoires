{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SearchRepertoire",
  "type": "object",
  "required": [
    "scientific_name",
    "common_name",
    "taxonomy",
    "calls",
    "provenance"
  ],
  "additionalProperties": false,
  "properties": {
    "scientific_name": { "type": "string", "minLength": 3 },
    "common_name": { "type": "string", "minLength": 1 },
    "taxonomy": { "$ref": "#/$defs/taxonomy" },
    "calls": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/call" }
    },
    "references": {
      "type": "object",
      "description": "Optional map of stable reference IDs to bibliographic entries.",
      "patternProperties": {
        "^[a-z][a-z0-9_]*$": { "$ref": "#/$defs/reference" }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/provenance_entry" }
    }
  },
  "$defs": {
    "taxonomy": {
      "type": "object",
      "required": [
        "kingdom",
        "phylum",
        "class",
        "order",
        "family",
        "genus",
        "species"
      ],
      "additionalProperties": false,
      "properties": {
        "kingdom": { "type": "string", "minLength": 1 },
        "phylum": { "type": "string", "minLength": 1 },
        "class": { "type": "string", "minLength": 1 },
        "order": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "genus": { "type": "string", "minLength": 1 },
        "species": { "type": "string", "minLength": 1 }
      }
    },
    "scope": {
      "type": "object",
      "required": [
        "life_stages",
        "sexes",
        "population_specific",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "life_stages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["infant", "juvenile", "adult", "unknown"]
          }
        },
        "sexes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["female", "male", "unknown"]
          }
        },
        "population_specific": { "type": "boolean" },
        "note": { "type": "string" }
      }
    },
    "call": {
      "type": "object",
      "required": [
        "name",
        "acoustic_keywords",
        "acoustic_description",
        "semantic_keywords",
        "semantic_description",
        "confidence"
      ],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "alternative_names": {
          "type": "array",
          "items": { "type": "string" }
        },
        "scope": { "$ref": "#/$defs/scope" },
        "acoustic_keywords": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/acoustic_keyword" }
        },
        "acoustic_description": { "type": "string", "minLength": 1 },
        "semantic_keywords": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/semantic_keyword" }
        },
        "semantic_description": { "type": "string", "minLength": 1 },
        "confidence": {
          "type": "string",
          "enum": ["low", "medium", "high"]
        },
        "references": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "provenance_entry": {
      "type": "object",
      "required": ["timestamp", "model", "action"],
      "additionalProperties": false,
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "model": { "type": "string", "minLength": 1 },
        "action": {
          "type": "string",
          "enum": ["generated", "updated"]
        },
        "notes": { "type": "string" }
      }
    },
    "acoustic_keyword": {
      "type": "string",
      "enum": [
        "high_frequency",
        "low_frequency",
        "frequency_modulated",
        "tonal",
        "broadband",
        "noisy",
        "harmonic",
        "short",
        "long",
        "abrupt",
        "repetitive",
        "pulsed",
        "multi_component",
        "loud",
        "quiet",
        "graded"
      ]
    },
    "semantic_keyword": {
      "type": "string",
      "enum": [
        "contact",
        "group_coordination",
        "affiliation",
        "threat",
        "aggression",
        "submission",
        "alarm",
        "predator",
        "distress",
        "begging",
        "caregiving",
        "courtship",
        "mating",
        "food",
        "recruitment",
        "territorial",
        "spacing",
        "identity",
        "attention",
        "play",
        "display",
        "combinatorial"
      ]
    },
    "reference": {
      "type": "object",
      "required": ["citation"],
      "additionalProperties": false,
      "properties": {
        "citation": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "format": "uri" },
        "doi": { "type": "string" }
      }
    }
  }
}
