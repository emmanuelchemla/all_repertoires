# To get the interactive plot in a notebook:

from plot import run_interactive

# 2D
fig = run_interactive(
    json_path="database.json",
    embedding_model="sentence-transformers/all-MiniLM-L6-v2",
    cache=".embedding_cache.json",
    n_components=2,
    width=900,
    height=700,
)
fig  # or fig.show() or run it twice if empty?

# 3D
fig = run_interactive(
    json_path="database.json",
    embedding_model="sentence-transformers/all-MiniLM-L6-v2",
    cache=".embedding_cache.json",
    n_components=3,
    width=900,
    height=700,
)
fig  # or fig.show() or run it twice if empty?
